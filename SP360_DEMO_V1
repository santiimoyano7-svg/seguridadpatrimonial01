<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
 
<title>SP360 - Security Operations Center</title>
 
<style>
 
:root{
--bg:#0B1220;
--panel:#111827;
--card:#1F2937;
 
--blue:#2563EB;
--green:#10B981;
--yellow:#FBBF24;
--red:#EF4444;
--orange:#F97316;
 
--text:#F8FAFC;
--text2:#CBD5E1;
}
 
*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial, Helvetica, sans-serif;
}
 
body{
background:var(--bg);
color:var(--text);
}
 
.app{
display:flex;
height:100vh;
}
 
.sidebar{
width:280px;
background:var(--panel);
padding:20px;
overflow:auto;
}
 
.logo{
font-size:28px;
font-weight:bold;
color:var(--blue);
margin-bottom:30px;
}
 
.sidebar button{
display:block;
width:100%;
padding:14px;
margin-bottom:10px;
background:none;
border:none;
color:white;
text-align:left;
cursor:pointer;
border-radius:10px;
}
 
.sidebar button:hover{
background:var(--card);
}
 
main{
flex:1;
padding:20px;
overflow:auto;
}
 
header{
display:flex;
justify-content:space-between;
align-items:center;
margin-bottom:25px;
}
 
.card{
background:var(--card);
padding:20px;
border-radius:12px;
margin-bottom:20px;
}
 
.stats{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
gap:20px;
}
 
.stat{
background:var(--card);
padding:20px;
border-radius:12px;
border-left:4px solid var(--blue);
}
 
.stat h1{
font-size:36px;
margin-top:10px;
}
 
.grid-lockers{
display:grid;
grid-template-columns:repeat(5,1fr);
gap:10px;
margin-top:20px;
}
 
.locker{
padding:12px;
text-align:center;
border-radius:8px;
font-weight:bold;
}
 
.ocupado{
background:var(--green);
}
 
.libre{
background:var(--blue);
}
 
.roto{
background:var(--red);
}
 
.sindeclarar{
background:var(--orange);
}
 
@media(max-width:768px){
 
.app{
flex-direction:column;
}
 
.sidebar{
width:100%;
}
 
.stats{
grid-template-columns:1fr;
